    "test": "node tests/geometry.test.mjs",
    "test:e2e": "node tests/e2e.verify.mjs",
    "verify": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.12.0"
  }
}
