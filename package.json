{
  "name": "jd-image2pdf",
  "version": "1.0.0",
  "private": true,
  "description": "JD Image2PDF — a premium, fully on-device image to PDF converter.",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server . -p 5173 -c-1 -o",
    "serve": "npx --yes http-server . -p 5173 -c-1",
